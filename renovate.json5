{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  extends: ["config:recommended"],

  minimumReleaseAge: "3 days",

  lockFileMaintenance: {
    enabled: true,
  },

  "git-submodules": {
    enabled: true,
  },

  mise: {
    enabled: true,
  },

  packageRules: [
    {
      description: "Group Ruby gem patch/minor updates into one PR.",
      matchManagers: ["bundler"],
      matchUpdateTypes: ["patch", "minor"],
      matchJsonata: ["isBreaking != true"],
      groupName: "Ruby gem patch/minor updates",
      groupSlug: "ruby-gem-patch-minor",
    },
    {
      description: "Skip Node.js and Ruby changelogs in dependency update PRs.",
      matchDatasources: ["node-version", "ruby-version"],
      fetchChangeLogs: "off",
    },
    {
      description: "Skip pnpm changelogs in dependency update PRs.",
      matchDatasources: ["npm"],
      matchPackageNames: ["pnpm"],
      fetchChangeLogs: "off",
    },
  ],
}
