<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title><%= search_setting.name %></title>
</head>
<body>
    <p><%= search_setting.bio %></p>
    <% search_result.each do |video| %>
    <p><a href="/articles/<%= userid %>/<%= video.id %>"><%= video.title %></a></p>
    <% end %>
</body>
</html>
